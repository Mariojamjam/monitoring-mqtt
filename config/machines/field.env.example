# A field machine of a distributed setup: the devices (publishers) and the monitors, using
# the gateway's broker. Experiments run from here. Copy to the project directory as .env
# (docs/deploy-raspberry-pi.md) and replace 192.168.0.50 with the gateway's address.

STACK_ROLES=devices,monitors
NODE_NAME=field-1

MQTT_BROKER_HOST=192.168.0.50
MQTT_BROKER_PORT=1883

# The gateway's API: experiment probes ask it what was stored.
REMOTE_API_URL=http://192.168.0.50:8000

# Experiments sample and act on the gateway's containers through this Docker context:
#   docker context create gateway --docker host=ssh://pi@192.168.0.50
# EXPERIMENT_DOCKER_CONTEXTS=gateway

SMOKE_TIMEOUT_SECONDS=15
