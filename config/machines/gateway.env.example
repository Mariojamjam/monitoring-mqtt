# The gateway of a distributed setup, for example a Raspberry Pi: the broker, the history
# (PostgreSQL, API, ingestion consumer), the alert engine and the dashboard.
# Copy to the project directory as .env (docs/guides/deploy-raspberry-pi.md).

STACK_ROLES=broker,storage,alerts,dashboard
NODE_NAME=gateway

# Field machines connect to this broker: publish it on the network. It accepts anonymous
# connections: use an isolated lab network only.
MQTT_BIND_ADDRESS=0.0.0.0
MQTT_HOST_PORT=1883

# The dashboard, for browsers on the network.
DASHBOARD_BIND_ADDRESS=0.0.0.0
DASHBOARD_HOST_PORT=8501

# The API stays local (the dashboard reaches it inside Docker). 0.0.0.0 opens its reference
# (/docs) and lets experiment probes on field machines query it.
API_BIND_ADDRESS=0.0.0.0
API_HOST_PORT=8000

# Set before the first start (it is stored when the database volume is created).
POSTGRES_PASSWORD=change-me

# Memory limits, so one service cannot starve the broker (sizes for a 4 GB Pi).
POSTGRES_MEMORY_LIMIT=768m
API_MEMORY_LIMIT=384m
DASHBOARD_MEMORY_LIMIT=768m

SMOKE_TIMEOUT_SECONDS=15
