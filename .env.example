# Machine-specific settings. Copy to .env (git-ignored); the CLI and Docker Compose read it
# from the project directory, and shell variables take precedence. Experiment parameters do
# NOT belong here: they live in config/simulation.yaml, which `monitoring-mqtt stack up`
# always applies.

# Which parts of the stack run on this machine: any of broker, devices, monitors,
# storage (PostgreSQL, API, ingestion consumer), alerts (alert engine) and dashboard.
# The default runs everything here. Example split: the broker on one machine
# (STACK_ROLES=broker) and devices on others (STACK_ROLES=devices + MQTT_BROKER_HOST).
STACK_ROLES=broker,devices,monitors,storage,alerts,dashboard

# A broker running elsewhere: an IP address or hostname of another machine, or 127.0.0.1
# (localhost) for a tunnel endpoint on this machine (on Linux, `stack up` then also starts
# the broker-relay so containers can reach it). Leave empty to use this stack's own broker;
# it must be empty when STACK_ROLES includes broker.
MQTT_BROKER_HOST=
# Port of that broker; only with MQTT_BROKER_HOST.
# MQTT_BROKER_PORT=1883

# Where this machine publishes its broker port. 127.0.0.1 keeps it local; 0.0.0.0 lets other
# machines connect. The broker allows anonymous access: expose it only on an isolated network.
MQTT_BIND_ADDRESS=127.0.0.1
# Change it only if 1883 is already in use on this machine.
MQTT_HOST_PORT=1883

# Label of this machine in worker claims and monitor status (default: its hostname).
# NODE_NAME=raspberry-pi

# How long `monitoring-mqtt test smoke` waits for broker connection and the probe round
# trip. Raise it on slow machines, busy CI runners or remote brokers.
SMOKE_TIMEOUT_SECONDS=10

# Where this machine publishes the API (storage role). 127.0.0.1 keeps it local; the API has
# no authentication. Reference: http://127.0.0.1:8000/docs
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000

# Where this machine publishes the dashboard (dashboard role); no authentication either.
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_HOST_PORT=8501
# The API the dashboard reads, when it runs on another machine (default: this stack's API).
# DASHBOARD_API_URL=http://192.168.0.60:8000

# PostgreSQL password (storage role). The database is never published on the host; change it
# before the first `stack up` (it is set when the volume is created).
POSTGRES_PASSWORD=monitoring
