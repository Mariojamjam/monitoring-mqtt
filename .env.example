# Machine-specific settings. Copy to .env (git-ignored); Docker Compose reads it from the
# project directory. Experiment parameters do NOT belong here: they live in
# config/simulation.yaml, which `monitoring-mqtt stack up` always applies.

# Host port for optional MQTT access on 127.0.0.1 (services always use broker:1883).
# Change it only if 1883 is already in use on this machine.
MQTT_HOST_PORT=1883

# How long `monitoring-mqtt test smoke` waits for broker connection and the probe round
# trip. Raise it on slow machines or busy CI runners.
SMOKE_TIMEOUT_SECONDS=10
